<Window x:Class="PWPartyScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PW Party Scanner — clean build" Height="760" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Аналіз учасників зі скріншотів" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,0"
                       Text="OCR виконується локально Tesseract. Читаються «Гравці поряд» + «Члени групи». У списки потрапляють лише ніки з players_list.txt зі збігом ≥ 90%."
                       TextWrapping="Wrap"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,14,0,12" VerticalAlignment="Center">
            <Button x:Name="SelectButton" Width="170" Height="38" Margin="0,0,10,8" Click="SelectButton_Click">1. Обрати скріншоти</Button>
            <Button x:Name="ProcessButton" Width="150" Height="38" Margin="0,0,10,8" Click="ProcessButton_Click" IsEnabled="False">2. Опрацювати</Button>
            <Button x:Name="ExportButton" Width="150" Height="38" Margin="0,0,20,8" Click="ExportButton_Click" IsEnabled="False">3. Вивести у файл</Button>

            <CheckBox x:Name="MergeScreenshotsCheckBox"
                      Margin="0,0,0,8"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Content="Об'єднати унікальних гравців по всіх скріншотах"
                      Checked="MergeScreenshotsCheckBox_Changed"
                      Unchecked="MergeScreenshotsCheckBox_Changed"/>
        </WrapPanel>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                <StackPanel>
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,9" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Margin="4,4,4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding FileName, Mode=OneWay}"/>
                                            <TextBlock Grid.Column="1" Margin="20,0,4,0" Foreground="#555">
                                                <Run Text="Поряд: "/><Run Text="{Binding NearbyCount, Mode=OneWay}"/>
                                                <Run Text="   Група: "/><Run Text="{Binding PartyCount, Mode=OneWay}"/><Run Text=" із "/><Run Text="{Binding PartyDetectedCount, Mode=OneWay}"/>
                                                <Run Text="   Унікальних: "/><Run Text="{Binding UniqueCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Expander.Header>

                                    <Border Padding="12" Margin="20,2,4,8" BorderBrush="#DDDDDD" BorderThickness="1" Background="White" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontWeight="Bold" Margin="0,0,0,2">
                                                    <Run Text="Гравці поряд — зі списку ("/><Run Text="{Binding NearbyCount, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,0,7" Foreground="#777" FontSize="12">
                                                    <Run Text="Рядків на скріні: "/><Run Text="{Binding NearbyDetectedCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding NearbyPlayers, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,1" Text="{Binding StringFormat='• {0}', Mode=OneWay}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontWeight="Bold" Margin="0,0,0,2">
                                                    <Run Text="Члени групи — зі списку ("/><Run Text="{Binding PartyCount, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,0,7" Foreground="#777" FontSize="12">
                                                    <Run Text="Рядків на скріні: "/><Run Text="{Binding PartyDetectedCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding PartyPlayers, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,1" Text="{Binding StringFormat='• {0}', Mode=OneWay}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock FontWeight="Bold" Margin="0,0,0,7">
                                                    <Run Text="Унікальні ("/><Run Text="{Binding UniqueCount, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding UniquePlayers, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,1" Text="{Binding StringFormat='• {0}', Mode=OneWay}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Margin="0,10,0,0" Foreground="#666" FontSize="12" Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander x:Name="CombinedExpander"
                              Visibility="Collapsed"
                              IsExpanded="True"
                              Margin="0,8,0,4"
                              Background="#F3F7FF">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <TextBlock FontSize="16" FontWeight="Bold" Text="Разом по всіх скріншотах"/>
                                <TextBlock Margin="12,0,0,0" Foreground="#555">
                                    <Run Text="Унікальних: "/><Run x:Name="CombinedCountRun" Text="0"/>
                                </TextBlock>
                            </StackPanel>
                        </Expander.Header>
                        <Border Padding="12" Margin="20,2,4,8" BorderBrush="#B8C8E8" BorderThickness="1" Background="White" CornerRadius="4">
                            <ItemsControl x:Name="CombinedPlayersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" Text="{Binding StringFormat='• {0}', Mode=OneWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,10,0,0" Text="Оберіть один або кілька PNG/JPG скріншотів."/>
    </Grid>
</Window>
